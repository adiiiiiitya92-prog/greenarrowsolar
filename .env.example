# Copy to .env.local (dev) or set in your host's dashboard (production). NEVER commit real values.
# Public values are safe in the browser; everything else stays on the server.
NEXT_PUBLIC_SITE_URL=https://greenarrowsolar.com
NEXT_PUBLIC_PHONE=+919876543210
NEXT_PUBLIC_PHONE_DISPLAY="+91 98765 43210"
NEXT_PUBLIC_WHATSAPP=919876543210
NEXT_PUBLIC_EMAIL=info@greenarrowsolar.com
# Google Analytics 4 measurement ID (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=

# SERVER ONLY — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Optional: where the SQLite DB and backups live (use a persistent disk in production)
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_KEEP=14
